{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    // So `examples/**` — which the README quotes verbatim — compiles against
    // the real published entry points rather than relative paths.
    "paths": {
      "@coloop-ai/terac-sdk": ["./src/index.ts"],
      "@coloop-ai/terac-sdk/webhooks": ["./src/webhooks.ts"],
      "@coloop-ai/terac-sdk/callback": ["./src/callback.ts"],
      "@coloop-ai/terac-sdk/zod": ["./src/zod.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "tests/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["dist", "node_modules"]
}
